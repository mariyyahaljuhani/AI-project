import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# تحميل البيانات الناتجة من المرحلة الثانية
df = pd.read_csv('/content/final_features_data.csv')

# ضبط الثيم العام للرسومات
sns.set_theme(style="whitegrid")
print("تم تحميل البيانات الجاهزة للتحليل بصرياً.")


# رسم توزيع 3 ميزات رقمية: GrLivArea, TotalBsmtSF, LotArea
features = ['GrLivArea', 'TotalBsmtSF', 'LotArea']
plt.figure(figsize=(15, 5))

for i, col in enumerate(features):
    plt.subplot(1, 3, i+1)
    sns.histplot(df[col], kde=True, color='skyblue')
    plt.title(f'Distribution of {col}')

plt.tight_layout()
plt.show()

# Insight (فقرة التحليل):
# نلاحظ أن معظم التوزيعات "Positive Skewed" (مائلة لليمين)، خاصة في مساحة الأرض (LotArea).
# هذا يعني أن أغلب البيوت تتركز في مساحات متوسطة وصغيرة، بينما توجد قلة من البيوت بمساحات ضخمة جداً.


# مقارنة السعر عبر فئتين: OverallQual (الجودة) و Age_Group (الفئة العمرية)

# Fix: Create 'Age_Group' column if it doesn't exist
# Assuming 'YearBuilt' is available in the DataFrame
if 'YearBuilt' in df.columns:
    median_year = df['YearBuilt'].median()
    df['Age_Group'] = df['YearBuilt'].apply(lambda x: 'New' if x >= median_year else 'Old')
else:
    print("Warning: 'YearBuilt' column not found. Cannot create 'Age_Group'. Please ensure 'YearBuilt' is in the DataFrame.")

plt.figure(figsize=(15, 6))

plt.subplot(1, 2, 1)
sns.boxplot(x='OverallQual', y='SalePrice', data=df, palette='viridis', hue='OverallQual', legend=False)
plt.title('SalePrice vs Overall Quality')

plt.subplot(1, 2, 2)
# Check again if 'Age_Group' was created before plotting
if 'Age_Group' in df.columns:
    sns.boxplot(x='Age_Group', y='SalePrice', data=df, palette='magma', hue='Age_Group', legend=False)
    plt.title('SalePrice vs House Age Group')
else:
    plt.text(0.5, 0.5, "Age_Group plot skipped due to missing 'YearBuilt' column.", horizontalalignment='center', verticalalignment='center', transform=plt.gca().transAxes, fontsize=12, color='red')

plt.show()

# Insight (فقرة التحليل):
# يظهر الرسم الأول علاقة طردية قوية جداً؛ فكلما زادت الجودة ارتفع السعر بشكل ملحوظ.
# في الرسم الثاني، نجد أن البيوت المصنفة كـ "New" لديها متوسط أسعار أعلى ومدى سعري أوسع مقارنة بالبيوت القديمة "Old".


# رسم العلاقة بين المساحة والسعر مع تلوين النقاط حسب الجودة
plt.figure(figsize=(10, 6))
sns.scatterplot(x='GrLivArea', y='SalePrice', hue='OverallQual', size='OverallQual', data=df, palette='coolwarm', alpha=0.7)
plt.title('Relationship: Area vs Price (Colored by Quality)')
plt.show()

# Insight (فقرة التحليل):
# الرسم يوضح وجود اتجاه صاعد؛ كلما زادت المساحة زاد السعر.
# ولكن التلوين يكشف أن النقاط الحمراء (الجودة العالية) تقع دائماً في الأعلى، مما يعني أن الجودة ترفع السعر حتى لو كانت المساحة صغيرة.


# حساب متوسط السعر حسب فئة جودة المطبخ (KitchenQual_Ordinal)
summary = df.groupby('KitchenQual_Ordinal')['SalePrice'].mean().sort_values()

print("متوسط السعر حسب جودة المطبخ (من الأقل للأعلى):")
print(summary)

# Insight (فقرة التحليل):
# نلاحظ أن المنازل التي حصلت على أعلى تقييم لجودة المطبخ (المستوى 5) لديها أعلى متوسط سعر.
# بينما المنازل ذات الجودة المنخفضة (المستوى 1 أو 2) هي الأقل سعراً، مما يدل على أهمية المطبخ في تثمين البيت.
