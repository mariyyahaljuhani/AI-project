# ==========================================
# 2. Data Cleaning Function
# ==========================================

def clean_data(input_df):
    data = input_df.copy()

    # أ) Handling Duplicates (التعامل مع التكرار)
    duplicate_count = data.duplicated().sum()
    print(f"\n Duplicated rows: {duplicate_count}")
    if duplicate_count > 0:
        data = data.drop_duplicates()


    # ب) Fixing Data Types (تعديل أنواع البيانات)
    # 1. تحويل MSSubClass إلى نص لأنه كود تصنيفي وليس رقمي حسابي
    data['MSSubClass'] = data['MSSubClass'].astype(str)
    # 2. تحويل MoSold (شهر البيع) إلى نص (Category)
    data['MoSold'] = data['MoSold'].astype(str)


    # ج) Finding & Handling Missing Values (القيم الناقصة)
    # نحدد الأعمدة التي بها مفقودات كثيرة ونحذفها
    cols_to_drop = ['PoolQC', 'MiscFeature', 'Alley', 'Fence', 'FireplaceQu']
    data.drop(columns=cols_to_drop, inplace=True, errors='ignore')


    # تعبئة القيم الرقمية بالوسيط (Median)
    numeric_cols = data.select_dtypes(include=[np.number]).columns
    data[numeric_cols] = data[numeric_cols].fillna(data[numeric_cols].median())


    # تعبئة القيم النصية بالـ Mode
    categorical_cols = data.select_dtypes(include=['object']).columns
    for col in categorical_cols:
        data[col] = data[col].fillna(data[col].mode()[0])


    # د) Spot & Handle Outliers (القيم الشاذة)
    # عشان نطلع البيت اللي سعره اعلى من 99بالمية من باقي البيوت يعني نقفط النصاب
    upper_limit = data['SalePrice'].quantile(0.99)
    data['SalePrice'] = data['SalePrice'].clip(upper=upper_limit)
    print(f"Upper limit: {upper_limit}")

    return data


# تشغيل دالة التنظيف
df_cleaned = clean_data(df)


