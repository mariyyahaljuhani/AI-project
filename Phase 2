import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import StandardScaler

# تحميل البيانات المنظفة من الملف السابق
df = pd.read_csv('/content/cleaned_data_new.csv')

print(f"تم تحميل البيانات بنجاح. الحجم: {df.shape}")
print(f"إجمالي القيم المفقودة: {df.isnull().sum().sum()}")

# 1. One-hot encode (MSZoning & Street)
# السبب: المودل يحتاج أرقاماً لفهم تصنيفات المناطق والشوارع بدلاً من النصوص.

# Define columns to potentially one-hot encode
cols_to_onehot = ['MSZoning', 'Street']

# Filter out columns that do not exist in the DataFrame
existing_cols_to_onehot = [col for col in cols_to_onehot if col in df.columns]

if existing_cols_to_onehot:
    df = pd.get_dummies(df, columns=existing_cols_to_onehot, drop_first=True)
    print(f"تم تطبيق One-hot encoding على الأعمدة: {existing_cols_to_onehot}")
else:
    print(f"الأعمدة {', '.join(cols_to_onehot)} غير موجودة في DataFrame، لم يتم تطبيق One-hot encoding.")

# 2. Ordinal encode (KitchenQual)
# السبب: جودة المطبخ لها ترتيب منطقي (ممتاز > جيد > مقبول) وهذا الترتيب يؤثر طردياً على السعر.
qual_map = {'Ex': 5, 'Gd': 4, 'TA': 3, 'Fa': 2, 'Po': 1}

if 'KitchenQual' in df.columns:
    df['KitchenQual_Ordinal'] = df['KitchenQual'].map(qual_map).fillna(0)
    print("تم تطبيق Ordinal encoding على عمود 'KitchenQual'.")
else:
    print("العمود 'KitchenQual' غير موجود في DataFrame، لم يتم تطبيق Ordinal encoding.")

print(qual_map)
# print(df) # Commenting this out to avoid printing a very large DataFrame
print("تم الانتهاء من عملية الـ Encoding.")

# 1. Create Domain Features
# أ) نسبة السعر للمساحة (Price per SqFt) مع قسمة آمنة
df['price_per_sqft'] = df['SalePrice'] / df['GrLivArea'].replace(0, np.nan)
df['price_per_sqft'] = df['price_per_sqft'].fillna(0)
# السبب: تعطي فكرة عن قيمة القدم المربع الواحد للمقارنة العادلة بين البيوت.

# ب) إجمالي عدد الحمامات (Total Bathrooms)
df['TotalBath'] = df['FullBath'] + (0.5 * df['HalfBath']) + df['BsmtFullBath']
# السبب: ميزة موحدة تجمع كل مرافق الاستحمام في المنزل في رقم واحد.

# 2. Create Interaction Feature (OverallQual × GrLivArea)
df['Qual_x_Area'] = df['OverallQual'] * df['GrLivArea']
# السبب: تأثير مساحة المنزل على السعر يتضاعف عندما تكون جودة التشطيب عالية.


print(df)
print("تم إنشاء الميزات الجديدة بنجاح.")

# 1. Log-transform (SalePrice) - عرض الهيستوجرام قبل وبعد
plt.figure(figsize=(12, 5))
plt.subplot(1, 2, 1)
sns.histplot(df['SalePrice'], kde=True, color='blue').set_title('Before Log Transform')

df['SalePrice_Log'] = np.log1p(df['SalePrice'])

plt.subplot(1, 2, 2)
sns.histplot(df['SalePrice_Log'], kde=True, color='green').set_title('After Log Transform')
plt.show()
# السبب: تقليل الانحراف (Skewness) في الأسعار يجعل البيانات تتبع التوزيع الطبيعي مما يحسن دقة المودل.

# 2. Binning (Age Groups)
# تقسيم سنة البناء (YearBuilt) إلى مجموعات (Old, Recent, New)
df['House_Age_Group'] = pd.cut(df['YearBuilt'], bins=[0, 1950, 1990, 2030], labels=['Old', 'Recent', 'New'])
# السبب: يسهل التحليل عند معرفة "الحقبة الزمنية" للمنزل بدلاً من التعامل مع كل سنة بشكل فردي.

print("تم الانتهاء من التحويل والتقسيم.")

# 1. Scaling (StandardScaler)
# تحجيم LotArea و GrLivArea
scaler = StandardScaler()
df[['LotArea_Scaled', 'GrLivArea_Scaled']] = scaler.fit_transform(df[['LotArea', 'GrLivArea']])
# السبب: لضمان أن الميزات ذات الأرقام الكبيرة لا تسيطر على نتائج المودل.

# 2. Remove redundant features (Correlation > 0.95)
corr_matrix = df.select_dtypes(include=[np.number]).corr().abs()
upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
to_drop = [column for column in upper.columns if any(upper[column] > 0.95)]
df.drop(columns=to_drop, inplace=True)
# السبب: حذف الأعمدة التي تعطي نفس المعلومة تماماً لتجنب مشكلة الـ Multicollinearity.

print(f"الميزات المحذوفة: {to_drop}")

# حفظ الملف النهائي للمرحلة الثالثة
df.to_csv('final_features_data.csv', index=False)
print("تم حفظ الملف النهائي: final_features_data.csv")
